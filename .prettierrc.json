{
	"printWidth": 100,
	"tabWidth": 2,
	"useTabs": true,
	"semi": false,
	"singleQuote": false,
	"quoteProps": "as-needed",
	"jsxSingleQuote": false,
	"trailingComma": "all",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "always",
	"proseWrap": "preserve",
	"htmlWhitespaceSensitivity": "css",
	"plugins": ["@ianvs/prettier-plugin-sort-imports"],
	"importOrder": [
		"<BUILTIN_MODULES>",
		"<THIRD_PARTY_MODULES>",
		"^.*/assets/.*$",
		"^.*constants?$",
		"^(components|@web/components)/.*$",
		"^.*/components(/.*)?$",
		"^(common|@web/common)/.*$",
		"^.*/common(/.*)?$",
		"^(prisma|middleware|routes|job|api|platform|styles|pages|games|hub)(/.*)?$",
		"^(hooks|@web/hooks)/.*$",
		"^.*/hooks(/.*)?$",
		"^(locales|@web/locales)/.*$",
		"^(toolkit|@web/toolkit)/.*$",
		"^.*\\.type$",
		"^.*types(/.*)?$",
		"^[./].*$"
	]
}
