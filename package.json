{
	"name": "github-user-explorer",
	"version": "1.0.0",
	"description": "GitHub user search and exploration application",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"lint": "eslint src --ext .ts,.tsx",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,html,md}\"",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@emotion/react": "^11.11.4",
		"@emotion/styled": "^11.11.5",
		"@mui/icons-material": "^5.14.20",
		"@mui/material": "^5.14.20",
		"@reduxjs/toolkit": "^1.9.7",
		"axios": "^1.6.8",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-redux": "^8.1.3",
		"react-router-dom": "^6.30.6",
		"redux": "^4.2.1",
		"redux-persist": "^6.0.0"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@types/node": "^20.10.6",
		"@types/react": "^18.2.37",
		"@types/react-dom": "^18.2.15",
		"@typescript-eslint/eslint-plugin": "^6.17.0",
		"@typescript-eslint/parser": "^6.17.0",
		"@vitejs/plugin-react": "^4.2.1",
		"eslint": "^8.56.0",
		"prettier": "^3.9.10",
		"typescript": "^5.3.3",
		"vite": "^5.0.8"
	},
	"engines": {
		"node": ">=18.0.0",
		"npm": ">=9.0.0"
	}
}
